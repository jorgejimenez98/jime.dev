# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next-intl generated message types
messages/*.d.json.ts

# agent skills: downloaded ones are restored from skills-lock.json
# (`npx skills experimental_install`); project-owned skills stay versioned.
# `.claude/skills/*` symlinks into `.agents/skills` stay tracked (links only,
# not content) because experimental_install doesn't recreate them.
/.agents/skills/*
!/.agents/skills/file-architecture

# taste-skill inspector screenshots (the dealt direction.json stays versioned)
/.taste-skill/inspect/
